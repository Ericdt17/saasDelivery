# LivSight - API backend environment example
# Copy this file to `.env` and fill in real values.

# ---------------------------
# Database
# ---------------------------
# Postgres on staging/production server (not local Docker).
# If unset, the API falls back to SQLite (local dev only).
DB_TYPE=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME
PG_SSL=false
SKIP_MIGRATIONS=false
USE_CORE_API=false

# ---------------------------
# Server
# ---------------------------
API_PORT=3000
NODE_ENV=development
TIME_ZONE=UTC

# Comma-separated list of allowed origins (CORS). Must include your frontend URL(s).
ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------
# Auth (REQUIRED)
# ---------------------------
# Required for login (do NOT use a placeholder in real envs)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Enable Bearer token auth (Authorization header) as fallback.
# Useful for mobile apps that cannot use HTTP-only cookies.
AUTH_HEADER_FALLBACK=true

# ---------------------------
# Alerts / Webhooks (optional)
# ---------------------------
# Example: Discord webhook URL for API error alerts and startup notifications
BOT_ALERT_WEBHOOK_URL=

# Post to BOT_ALERT_WEBHOOK_URL when the API finishes startup (default: true)
# BOT_ALERT_STARTUP_ENABLED=true

# Optional commit label in startup alerts (set automatically by CD on deploy)
# DEPLOY_GIT_SHA=

# Discord webhook for new recruitment applications (separate channel)
RECRUITMENT_ALERT_WEBHOOK_URL=

# Optional: dashboard base URL for links in recruitment alerts (defaults to first ALLOWED_ORIGINS)
# RECRUITMENT_DASHBOARD_URL=https://app.livsight.com

# Discord webhook for HR check-in / presence errors (separate channel)
# HR_ALERT_WEBHOOK_URL=
# Optional throttle between identical alerts (default 5 minutes)
# HR_ALERT_COOLDOWN_MS=300000

# ---------------------------
# WhatsApp bot (HR payslip DM — signed download link)
# ---------------------------
# Must match BOT_INTERNAL_TOKEN on the WhatsApp bot health server.
# WHATSAPP_BOT_BASE_URL=http://127.0.0.1:3099
# WHATSAPP_BOT_INTERNAL_TOKEN=change-me-long-random-secret
# WHATSAPP_BOT_ENABLED=false
# Public API URL embedded in WhatsApp download links (must be reachable by the phone).
# WhatsApp often does NOT make raw http://IP:port links tappable — prefer an https domain:
#   cloudflared tunnel --url http://127.0.0.1:3000
# then set PUBLIC_API_BASE_URL to the https://….trycloudflare.com URL it prints.
# PUBLIC_API_BASE_URL=https://xxxx.trycloudflare.com
# Short-link store file (default: data/payslip-download-links.json)
# PAYSLIP_LINKS_FILE=data/payslip-download-links.json

# ---------------------------
# HR check-in office GPS (defaults = Hippodrome Yaoundé)
# Override for local testing (e.g. your location in France):
# HR_OFFICE_LAT=48.8566
# HR_OFFICE_LNG=2.3522
# HR_OFFICE_RADIUS_M=500
# ---------------------------
# HR_OFFICE_LAT=3.8721
# HR_OFFICE_LNG=11.5137
# HR_OFFICE_RADIUS_M=300

# Local testing only — skip Douala time window (always "present")
# HR_CHECKIN_IGNORE_TIME=true
# HR_CHECKIN_RATE_MAX=10

# ---------------------------
# Cloudinary (optional)
# ---------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
