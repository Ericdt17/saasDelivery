DB_TYPE=postgres
# Adjust to your local Postgres instance
DATABASE_URL=postgresql://postgres:password@localhost:5432/deliverybot

API_PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
TIME_ZONE=UTC

# HR office GPS — defaults Hippodrome; set to your coords while developing abroad
# HR_OFFICE_LAT=48.8566
# HR_OFFICE_LNG=2.3522
# HR_OFFICE_RADIUS_M=500

# HR_CHECKIN_IGNORE_TIME=true
# HR_CHECKIN_RATE_MAX=10

# Discord webhook for HR check-in errors (GPS/camera/face failures)
# HR_ALERT_WEBHOOK_URL=
# HR_ALERT_COOLDOWN_MS=300000

# LivSight delivery-ops integration (X-Api-Key pull of revenue/expense reports)
# LIVSIGHT_API_BASE_URL=http://localhost:8085
# LIVSIGHT_API_KEY=
# LIVSIGHT_HR_API_KEY=   # accepted as fallback for LIVSIGHT_API_KEY
